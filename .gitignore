# 机器本地 bot 名册（每台机各管各的·整盘覆盖 committed bridge-bots.json）
feishu/bridge-bots.local.json
feishu/bridge-cd-bookmarks.local.json
# 本机 agent profile→runtime/home/launcher 映射；新机由 profile_bootstrap 显式建立。
feishu/agent-profiles.local.json
feishu/agent-profiles.local.json.*.tmp
# 本机全局产物交付偏好；所有 Link16 profile/bot 共读，样例可提交。
feishu/artifact-delivery.local.json
# 跨机 agent 目录的本机覆盖（含全舰队 open_id + 主机名）
# 样例见 feishu/agent-registry.example.json；解析顺序见 feishu/bridge_env.py 的 registry_path()
# 当前 private 仓仍有 committed 现役本；受信 collaborator 可见这些运维元数据。
# 若将来对外公开，必须先完成 PLAN-926 的 local 迁移与历史边界处理。
# 舰队通讯录真数据（62 条真实 open_id + 群 chat_id + tenant_key + 主机名 + 内网 IP）
# 【永不进本仓】—— 公开仓只带 feishu/agent-registry.example.json 那份脱敏样例。
# 真数据的默认 SSOT 在 runtime profile home：
#   ~/.claude-personal/link16/agent-registry.json（没装 Claude 则 ~/.codex-personal/link16/）
# 解析顺序见 feishu/bridge_env.py 的 registry_path()。
# 维护者的 profile home 恰好是一个私有 git 仓的工作树，所以跨机同步照旧走 push/pull；
# 只有一台机的人它就是个本机目录。两种人共用同一条规则。
feishu/agent-registry.json
feishu/agent-registry.local.json
# 改名册前留的本机备份（含本机 cwd·跨机会打架·绝不入库）· 注：gitignore 不支持行尾注释，注释必须独占一行
feishu/*.local.json.bak*

# 本机凭据与密钥（只允许提交脱敏样例；真实值永不进 Git）
.env
.env.*
*.env
*.env.*
auth.json
.credentials.json
credentials.json
*.pem
*.key
*.p12
*.pfx
!.env.example
!*.env.example

# 桥运行态（会话/outbox/收据/锚点/收件箱·都是 runtime scratch）
feishu/_state/
feishu/_logs/
feishu/_tmp/
feishu/bridge-session-*.json
feishu/bridge-owner-*.json
feishu/bridge-outbox-*.jsonl
feishu/bridge-outbox-hwm-*.json
feishu/bridge-mirror-*.json
feishu/bridge-receipts-*.jsonl
feishu/bridge-pending-*.json
feishu/bridge-picker-*.json
feishu/bridge-cd-pending-*.json
feishu/bridge-hooks.json
feishu/inbox/

# python
__pycache__/
*.pyc

# Cloudflare Wrangler 本地缓存（部署 mockup 展厅时生成·非源码·会重建）
.wrangler/

# mockup 展厅索引（publish_mockup.py 每次部署自动生成·构建产物·不入库）
docs/mockups/index.html

# 一次性临时脚本（探索用·勿提交）
feishu/_fs_list_tmp.py

# 各机自己的定时任务定义（含私有业务 prompt）· 本机文件，不入库；格式见 feishu/cron-jobs/README.md
feishu/cron-jobs/*.yaml
