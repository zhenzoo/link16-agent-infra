{
  "version": 1,
  "default_profiles": {
    "claude": "ccp",
    "codex": "cxp"
  },
  "session_search": {
    "preferred_profiles": ["cc", "ccp", "ccp2", "cxp", "cx"]
  },
  "entry_documents": {
    "_note": "managed_profiles = 【入口文档治理范围】（哪些 profile 的 home 要被渲染 CLAUDE.md / AGENTS.md），不是【shell wrapper 范围】——wrapper 走 `agent_profile_cli.py list --names`，永远取 profiles 的全部键。所以这里比 profiles 少几个（ccw/ccw2/ccw3 不接受入口文档治理）是有意的，别当成漏补去『补齐』。见 PLAN-923 · S2.3。",
    "claude_source_profile": "ccp",
    "managed_profiles": [
      "cc",
      "ccp",
      "ccp2",
      "cck",
      "cx",
      "cxp"
    ]
  },
  "profiles": {
    "cc": {
      "runtime": "claude",
      "home": "~/.claude",
      "launcher": "direct",
      "label": "Claude Code 默认号"
    },
    "ccp": {
      "runtime": "claude",
      "home": "~/.claude-personal",
      "launcher": "direct",
      "label": "Claude Code Personal 母版"
    },
    "ccp2": {
      "runtime": "claude",
      "home": "~/.claude-personal2",
      "launcher": "launch-sh",
      "label": "Claude Code Personal 2"
    },
    "cck": {
      "runtime": "claude",
      "home": "~/.claude-kimi",
      "launcher": "launch-sh",
      "label": "Claude Code Kimi"
    },
    "ccw": {
      "runtime": "claude",
      "home": "~/.claude-work",
      "launcher": "direct",
      "label": "Claude Code Work"
    },
    "ccw2": {
      "runtime": "claude",
      "home": "~/.claude-work2",
      "launcher": "direct",
      "label": "Claude Code Work 2"
    },
    "ccw3": {
      "runtime": "claude",
      "home": "~/.claude-work3",
      "launcher": "direct",
      "label": "Claude Code Work 3"
    },
    "cx": {
      "runtime": "codex",
      "home": "~/.codex",
      "launcher": "direct",
      "label": "Codex 默认号"
    },
    "cxp": {
      "runtime": "codex",
      "home": "~/.codex-personal",
      "launcher": "direct",
      "label": "Codex Personal（生产推荐）",
      "recommended": true
    }
  }
}
