      "launcher": "launch-sh",
      "label": "Claude Code Kimi"
    },
    "ccw": {
      "runtime": "claude",
      "home": "~/.claude-work",
      "launcher": "direct",
      "label": "Claude Code Work"
    },
    "ccw2": {
      "runtime": "claude",
      "home": "~/.claude-work2",
      "launcher": "direct",
      "label": "Claude Code Work 2"
    },
    "ccw3": {
      "runtime": "claude",
      "home": "~/.claude-work3",
      "launcher": "direct",
      "label": "Claude Code Work 3"
