+  // Restore the native settings boundary without restoring the removed brains.
+  // The store emits onAutonomyWritten in THIS process; index.ts already clears
+  // the approval cache and publishes the changed workspace facts on that event.
+  const requireModeTarget = (event: IpcMainInvokeEvent, workspaceId: unknown): string => {
+    const win = getWindow();
+    if (!win || win.isDestroyed() || event.sender !== win.webContents
+        || event.senderFrame !== win.webContents.mainFrame) {
+      throw Object.assign(new Error('mode settings require the main window'), { code: 'PERMISSION_DENIED' });
+    }
+    if (typeof workspaceId !== 'string' || !/^[A-Za-z0-9._-]{1,80}$/.test(workspaceId)) {
+      throw Object.assign(new Error('invalid workspace id'), { code: 'VALIDATION_ERROR' });
+    }
+    if (!getWorkspaceMirror().getEntries()?.some((entry) => entry.id === workspaceId)) {
+      throw Object.assign(new Error('workspace is not in the live workspace mirror'), { code: 'NOT_FOUND' });
+    }
+    return workspaceId;
+  };
+  ipcMain.removeHandler(IPC.DECK_MODE_GET);
+  ipcMain.handle(IPC.DECK_MODE_GET, wrapHandler(IPC.DECK_MODE_GET, async (event, workspaceId: unknown) => {
+    return loadWorkspaceAutonomy(requireModeTarget(event, workspaceId), opts.dir);
+  }));
+  ipcMain.removeHandler(IPC.DECK_MODE_SET);
+  ipcMain.handle(IPC.DECK_MODE_SET, wrapHandler(IPC.DECK_MODE_SET, async (event, workspaceId: unknown, mode: unknown) => {
+    const id = requireModeTarget(event, workspaceId);
+    if (mode !== 'off' && mode !== 'assist' && mode !== 'danger') {
+      throw Object.assign(new Error('mode must be off, assist or danger'), { code: 'VALIDATION_ERROR' });
+    }
+    const after = await setWorkspaceMode(id, mode, opts.dir);
+    return { ...after, ok: after.mode === mode };
+  }));
+
